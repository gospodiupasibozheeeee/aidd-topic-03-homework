DJANGO_DEBUG=true
# Generate a stable random key for all application processes.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# sqlite runs without external services; postgresql uses the settings below.
DJANGO_DB_ENGINE=sqlite
POSTGRES_DB=investing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
MARKET_UPDATE_INTERVAL=10
# A read-only token is sufficient. Keep real credentials in the ignored .env.
TINKOFF_TOKEN=
TINKOFF_API_URL=https://invest-public-api.tbank.ru/rest
TINKOFF_TIMEOUT=10
# Optional trusted CA bundle path. TLS verification is always enabled.
TINKOFF_CA_BUNDLE=
