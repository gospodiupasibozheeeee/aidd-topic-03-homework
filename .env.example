# Copy to .env and adjust. Never commit the real .env or tokens.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver

# Database: sqlite (default, no external service) or postgresql.
DJANGO_DB_ENGINE=sqlite
SQLITE_PATH=db.sqlite3

# PostgreSQL settings (used when DJANGO_DB_ENGINE=postgresql).
POSTGRES_DB=investing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Celery. With CELERY_ALWAYS_EAGER=True no Redis worker is required for local
# tests; set it to False to run a real Beat/Worker.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_ALWAYS_EAGER=False
CELERY_TASK_TIME_LIMIT=1800
MARKET_UPDATE_INTERVAL=10

# Tinkoff Invest API. A read-only token is sufficient. Leave empty to run the
# catalogue without market data (the chart shows a friendly message).
TINKOFF_TOKEN=

# Localisation.
TIME_ZONE=Europe/Moscow

# Set to True behind HTTPS in production.
DJANGO_SECURE_COOKIES=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
