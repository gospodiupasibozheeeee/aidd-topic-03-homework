# Django configuration
DJANGO_SECRET_KEY=django-insecure-investing-demo-key-for-development-only-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],*

# Database: sqlite or postgresql
DJANGO_DB_ENGINE=sqlite
SQLITE_PATH=db.sqlite3

# PostgreSQL configuration (when DJANGO_DB_ENGINE=postgresql)
POSTGRES_DB=investing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Celery & Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_ALWAYS_EAGER=False

# Tinkoff / T-Bank Invest API
TINKOFF_TOKEN=
TINKOFF_API_URL=https://invest-public-api.tbank.ru/rest
TINKOFF_TIMEOUT=10
MARKET_UPDATE_INTERVAL=10
